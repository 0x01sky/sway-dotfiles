{
    "label": "lock",
    "action": "swaylock -i /usr/share/backgrounds/5748285.jpg",
    "text": "󰌾  Lock",
    "keybind": "l"
}
{
    "label": "logout",
    "action": "swaymsg exit",
    "text": "󰍃  Logout",
    "keybind": "e"
}
{
    "label": "suspend",
    "action": "swaylock -i /usr/share/backgrounds/5748285.jpg && systemctl suspend",
    "text": "󰒲  Suspend",
    "keybind": "s"
}
{
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "󰜉  Reboot",
    "keybind": "r"
}
{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "󰐥  Shutdown",
    "keybind": "p"
}
{
    "label": "hibernate",
    "action": "systemctl hibernate",
    "text": "󰤄  Hibernate",
    "keybind": "h"
}
